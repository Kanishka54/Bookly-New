<nav class="pagination" aria-label="Book pages">
  <% if (prevHref) { %>
    <a class="pagination-link" href="<%= prevHref %>">Previous</a>
  <% } else { %>
    <span class="pagination-link disabled" aria-disabled="true">Previous</span>
  <% } %>

  <% pages.forEach(function (item) { %>
    <% if (item.current) { %>
      <span class="pagination-link current" aria-current="page"><%= item.number %></span>
    <% } else { %>
      <a class="pagination-link" href="<%= item.href %>"><%= item.number %></a>
    <% } %>
  <% }); %>

  <% if (nextHref) { %>
    <a class="pagination-link" href="<%= nextHref %>">Next</a>
  <% } else { %>
    <span class="pagination-link disabled" aria-disabled="true">Next</span>
  <% } %>
</nav>
